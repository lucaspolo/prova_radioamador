# Copie este arquivo para .env e preencha com a sua chave.
#   cp .env.example .env

# Obrigatorio. Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Opcional. Modelo usado para gerar as questoes e para o OCR por visao.
# Precisa suportar Structured Outputs e entrada de imagem.
# Rode `python scripts/processar_pdfs.py --listar-modelos` para ver o que a sua
# conta tem disponivel. Exemplos: gpt-4o, gpt-4.1, gpt-5, gpt-5-mini
OPENAI_MODEL=gpt-4o

# Opcional. Diretorio com os PDFs de estudo.
DIRETORIO_PDFS=/home/lucaspolo/Downloads/materia_estudo_ra

{"veredito": [{"indice": 0, "consistente": true, "motivo": "Meteor scatter é usado em VHF (50/144 MHz), não apenas em HF."}, {"indice": 1, "consistente": true, "motivo": "Onda de superfície propaga-se melhor sobre água do mar (alta condutividade)."}, {"indice": 2, "consistente": true, "motivo": "QTH = localidade/posição da estação."}, {"indice": 3, "consistente": true, "motivo": "QRN = ruído atmosférico; QRM = interferência de outras estações/fontes artificiais."}, {"indice": 4, "consistente": true, "motivo": "QSY = mudar de frequência."}, {"indice": 5, "consistente": true, "motivo": "QSL = confirmação de recebimento/“entendido”."}, {"indice": 6, "consistente": true, "motivo": "QRO = aumentar potência; reduzir = QRP."}, {"indice": 7, "consistente": true, "motivo": "QRQ = enviar mais rápido; reduzir velocidade = QRS."}, {"indice": 8, "consistente": true, "motivo": "QRG = frequência exata de operação."}, {"indice": 9, "consistente": true, "motivo": "QSB = desvanecimento (fading) do sinal."}]}